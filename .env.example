# Host port the app is published on (docker-compose.dev.yml only; the prod
# stack has no published port, Traefik reaches it over the traefik network).
# The container always listens on 8080.
RALLY_PORT=8080

# Sync server (see docs/SYNC.md). All optional.
# RALLY_CORS_ORIGIN=https://xrtce.github.io
# RALLY_RETENTION_DAYS=365
# RALLY_TRUST_PROXY=1

# --- docker-compose.prod.yml only (Traefik) ---------------------------------

# Domain Traefik routes to this container. Required - the compose file
# refuses to start without it rather than register an empty Host() rule.
# RALLY_DOMAIN=rally.example.com

# Only needed if your Traefik's docker network or certresolver aren't named
# "traefik" / "letsencrypt".
# TRAEFIK_NETWORK=traefik
# TRAEFIK_CERT_RESOLVER=letsencrypt
